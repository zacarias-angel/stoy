# Entorno de ejecucion
NODE_ENV=development
PORT=4000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=en5estoy

# Autenticacion (cambiar por un secreto largo y aleatorio en produccion)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# CORS: origen permitido del frontend
CORS_ORIGIN=http://localhost:5173

# Membresia y descubrimiento
MEMBERSHIP_PRICE_ARS=1600
# Proveedor de pagos elegido: Mercado Pago. Nunca exponer estas claves al cliente.
# MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
# MERCADO_PAGO_WEBHOOK_SECRET=secreto-del-webhook

# Ubicacion / descubrimiento (todas opcionales, tienen valores por defecto)
# LOCATION_SECRET=secreto-para-ofuscar-ubicacion-publica
# NEARBY_RADIUS_FREE_METERS=500
# NEARBY_RADIUS_MEMBER_METERS=4000
# NEARBY_MAX_RADIUS_METERS=4000
# NEARBY_MIN_RESULTS=3
# NEARBY_PAGE_SIZE=30
